{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "palette": [
        { "color": "#0645f5", "name": "Blixis Blue", "slug": "primary" },
        { "color": "#08c7dc", "name": "Cyan", "slug": "accent" },
        { "color": "#ffffff", "name": "White", "slug": "surface" },
        { "color": "#111827", "name": "Ink", "slug": "foreground" },
        { "color": "#465675", "name": "Slate", "slug": "muted" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "name": "System", "slug": "body" },
        { "fontFamily": "Georgia, 'Times New Roman', serif", "name": "Editorial", "slug": "heading" }
      ],
      "fontSizes": [
        { "fluid": false, "name": "Small", "size": "0.875rem", "slug": "small" },
        { "fluid": false, "name": "Base", "size": "1rem", "slug": "base" },
        { "fluid": false, "name": "Large", "size": "1.25rem", "slug": "large" },
        { "fluid": false, "name": "Display", "size": "clamp(2.75rem, 6vw, 6rem)", "slug": "display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|surface",
      "text": "var:preset|color|foreground"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "500",
          "lineHeight": "1.15"
        }
      }
    }
  }
}
