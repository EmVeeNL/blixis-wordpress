        },
        "md": {
          "type": "string",
          "pattern": "^(?:none|(?:inset )?-?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) (?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) #(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})(?:, (?:inset )?-?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) (?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) #(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})){0,3})$"
        },
        "lg": {
          "type": "string",
          "pattern": "^(?:none|(?:inset )?-?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) (?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) #(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})(?:, (?:inset )?-?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) (?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) -?(?:0|(?:[1-9][0-9]{0,2}|0)(?:\\.[0-9]{1,3})?(?:rem|px)) #(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})){0,3})$"
        }
