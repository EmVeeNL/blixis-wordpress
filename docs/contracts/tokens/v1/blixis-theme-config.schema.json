  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "parent"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "parent": {
          "const": "blixis-base"
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "surface",
        "foreground",
        "muted",
        "accent"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "heading",
        "mono"
      ],
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^(?=.{1,64}$)[A-Za-z][A-Za-z0-9]*(?:[ -][A-Za-z0-9]+){0,7}$"
        },
        "heading": {
          "type": "string",
          "pattern": "^(?=.{1,64}$)[A-Za-z][A-Za-z0-9]*(?:[ -][A-Za-z0-9]+){0,7}$"
        },
        "mono": {
          "type": "string",
          "pattern": "^(?=.{1,64}$)[A-Za-z][A-Za-z0-9]*(?:[ -][A-Za-z0-9]+){0,7}$"
        }
      }
    },
    "typeScale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xs",
        "sm",
        "base",
        "lg",
        "xl",
        "2xl",
        "3xl"
      ],
      "properties": {
        "xs": {
          "type": "string",
          "pattern": "^(?:0|(?:[1-9][0-9]{0,3}|0)(?:\\.[0-9]{1,4})?(?:rem|px))$"
        },
        "sm": {
          "type": "string",
          "pattern": "^(?:0|(?:[1-9][0-9]{0,3}|0)(?:\\.[0-9]{1,4})?(?:rem|px))$"
        },
