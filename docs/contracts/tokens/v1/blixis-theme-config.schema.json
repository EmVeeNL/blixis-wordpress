          "type": "string",
          "pattern": "^(?:0|(?:[1-9][0-9]{0,3}|0)(?:\\.[0-9]{1,4})?(?:rem|px))$"
        },
        "md": {
          "type": "string",
          "pattern": "^(?:0|(?:[1-9][0-9]{0,3}|0)(?:\\.[0-9]{1,4})?(?:rem|px))$"
