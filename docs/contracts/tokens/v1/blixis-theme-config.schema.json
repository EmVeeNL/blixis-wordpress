{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blixis.invalid/contracts/tokens/v1/blixis-theme-config.schema.json",
  "title": "BlixisThemeConfig v1",
  "description": "Generated from token-map.json. Patterns use ECMA-262 semantics; a PCRE implementation must add the D modifier, or $ accepts a trailing newline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "theme",
    "colors",
    "fonts",
    "typeScale",
    "spacing",
    "radius",
    "layout",
    "shadows",
    "motion",
    "breakpoints"
