{
  "name": "blixis-compat-spike-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Throwaway proof for task 01-02. Workspace member until real TypeScript packages exist; not product code.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o dist-css/output.css --minify",
    "check:css": "node tests/check-tailwind.ts",
    "build": "pnpm run typecheck && pnpm run build:css && pnpm run check:css && vite build",
    "test:browsers": "playwright test",
    "licenses": "node tests/check-licenses.ts",
    "lint": "oxlint --deny-warnings --type-aware --type-check src tests playwright.config.ts vite.config.ts",
    "format:check": "oxfmt --check src tests playwright.config.ts vite.config.ts package.json tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@tabler/icons-react": "3.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
